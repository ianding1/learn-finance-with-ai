---
// One question: label, result, points and suggested time (quiz questions only), and text. Answers are not entered on the site; the learner writes
// them on paper (or types them after the copied prompt) and submits them at the end of the lesson.
// The result (not answered / OK / needs revision) is filled in from the stored progress by
// src/scripts/questions.ts.
import { t, type Lang } from '../i18n/ui';
import { renderRich, type Question } from '../lib/course';

interface Props {
	q: Question;
	lang: Lang;
	lessonId: string;
	label: string;
}
const { q, lang, lessonId, label } = Astro.props;
---

<div class="lfwai-q" id={`q-${q.id}`}>
	<div class="lfwai-q-head">
		<span class="lfwai-q-label">{label}{q.star ? ' ★' : ''}</span>
		<span class="lfwai-q-meta">
			<span class="lfwai-q-status" data-q-status={q.id} hidden></span>
			{q.points != null && (
				<span class="lfwai-q-points">
					{t(lang, 'points', { n: q.points })}
					{q.minutes != null && ` · ${t(lang, 'minutes', { n: q.minutes })}`}
				</span>
			)}
		</span>
	</div>
	<div class="lfwai-q-text" set:html={renderRich(q.question[lang], lang, lessonId)} />
</div>
