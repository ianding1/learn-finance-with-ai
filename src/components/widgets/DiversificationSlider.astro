---
// Figure 6-1: portfolio standard deviation as a function of the weight in A, for an adjustable ρ.
// Parameters and ranges are registered in course/widgets.yaml (id: diversification). Keep them in sync.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	zh: {
		rho: '相关系数 ρ',
		w: 'A 的权重 w',
		xAxis: 'A 的权重 w',
		yAxis: '标准差（%）',
		avg: '加权平均',
		port: '组合标准差',
		gap: '差额',
		min: '波动最小点',
		readout: '当前：组合标准差 {p}%，加权平均 {a}%，差额 {g} 个百分点。波动最小点：w = {mw}%，标准差 {ms}%。',
	},
	en: {
		rho: 'Correlation ρ',
		w: 'Weight in A, w',
		xAxis: 'Weight in A, w',
		yAxis: 'Standard deviation (%)',
		avg: 'Weighted average',
		port: 'Portfolio std. dev.',
		gap: 'Gap',
		min: 'Minimum-volatility point',
		readout: 'Now: portfolio standard deviation {p}%, weighted average {a}%, gap {g} percentage points. Minimum-volatility point: w = {mw}%, standard deviation {ms}%.',
	},
}[lang];

// Plot geometry
const W = 640;
const H = 340;
const pad = { l: 56, r: 20, t: 20, b: 50 };
const yMax = 22;
const X = (w: number) => pad.l + w * (W - pad.l - pad.r);
const Y = (s: number) => pad.t + (1 - s / yMax) * (H - pad.t - pad.b);
const yTicks = [0, 5, 10, 15, 20];
const xTicks = [0, 0.25, 0.5, 0.75, 1];
---

<div class="lfwai-widget" data-widget="diversification" data-sigma-a="20" data-sigma-b="10" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.rho} = <output data-out="rho">0.50</output></span>
			<input type="range" min="-1" max="1" step="0.05" value="0.5" data-param="rho" />
		</label>
		<label>
			<span>{L.w} = <output data-out="w">50%</output></span>
			<input type="range" min="0" max="1" step="0.01" value="0.5" data-param="w" />
		</label>
	</div>
	<svg class="lfwai-viz" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${L.port}, σA = 20%, σB = 10%`}>
		{yTicks.map((s) => (
			<g>
				<line class="viz-grid" x1={pad.l} x2={W - pad.r} y1={Y(s)} y2={Y(s)} />
				<text class="viz-tick" x={pad.l - 8} y={Y(s) + 4} text-anchor="end">{s}</text>
			</g>
		))}
		{xTicks.map((w) => (
			<text class="viz-tick" x={X(w)} y={H - pad.b + 18} text-anchor="middle">{`${w * 100}%`}</text>
		))}
		<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.xAxis}</text>
		<text class="viz-tick" transform={`translate(14 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.yAxis}</text>
		<line class="viz-axis" x1={pad.l} x2={W - pad.r} y1={Y(0)} y2={Y(0)} />
		<line class="viz-avg" x1={X(0)} y1={Y(10)} x2={X(1)} y2={Y(20)} />
		<path class="viz-port" data-el="curve" d="" />
		<line class="viz-gap" data-el="gap" x1="0" y1="0" x2="0" y2="0" />
		<circle class="viz-cur" data-el="cur" r="5" cx="0" cy="0" />
		<circle class="viz-min" data-el="min" r="6" cx="0" cy="0" />
	</svg>
	<ul class="lfwai-legend">
		<li><span class="sw sw-avg"></span>{L.avg}</li>
		<li><span class="sw sw-port"></span>{L.port}</li>
		<li><span class="sw sw-gap"></span>{L.gap}</li>
		<li><span class="sw sw-min"></span>{L.min}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
	<script type="application/json" data-geom set:html={JSON.stringify({ W, H, pad, yMax })}></script>
</div>

<script>
	interface Geom {
		W: number;
		H: number;
		pad: { l: number; r: number; t: number; b: number };
		yMax: number;
	}

	document.querySelectorAll<HTMLElement>('[data-widget="diversification"]').forEach((root) => {
		const g = JSON.parse(root.querySelector('[data-geom]')!.textContent!) as Geom;
		const sa = Number(root.dataset.sigmaA);
		const sb = Number(root.dataset.sigmaB);
		const X = (w: number) => g.pad.l + w * (g.W - g.pad.l - g.pad.r);
		const Y = (s: number) => g.pad.t + (1 - s / g.yMax) * (g.H - g.pad.t - g.pad.b);
		const sd = (w: number, rho: number) =>
			Math.sqrt(Math.max(0, w * w * sa * sa + (1 - w) * (1 - w) * sb * sb + 2 * w * (1 - w) * rho * sa * sb));
		const el = (name: string) => root.querySelector<SVGElement & HTMLElement>(`[data-el="${name}"]`)!;
		const rhoIn = root.querySelector<HTMLInputElement>('[data-param="rho"]')!;
		const wIn = root.querySelector<HTMLInputElement>('[data-param="w"]')!;
		const f = (v: number, d = 2) => v.toFixed(d);

		function draw() {
			const rho = Number(rhoIn.value);
			const w = Number(wIn.value);
			let d = '';
			for (let i = 0; i <= 200; i++) {
				const x = i / 200;
				d += `${i ? 'L' : 'M'}${X(x).toFixed(1)},${Y(sd(x, rho)).toFixed(1)}`;
			}
			el('curve').setAttribute('d', d);

			const p = sd(w, rho);
			const a = w * sa + (1 - w) * sb;
			const gap = el('gap');
			gap.setAttribute('x1', String(X(w)));
			gap.setAttribute('x2', String(X(w)));
			gap.setAttribute('y1', String(Y(a)));
			gap.setAttribute('y2', String(Y(p)));
			const cur = el('cur');
			cur.setAttribute('cx', String(X(w)));
			cur.setAttribute('cy', String(Y(p)));

			const denom = sa * sa + sb * sb - 2 * rho * sa * sb;
			const mw = denom > 1e-9 ? Math.min(1, Math.max(0, (sb * sb - rho * sa * sb) / denom)) : 0;
			const ms = sd(mw, rho);
			const min = el('min');
			min.setAttribute('cx', String(X(mw)));
			min.setAttribute('cy', String(Y(ms)));

			root.querySelector('[data-out="rho"]')!.textContent = f(rho);
			root.querySelector('[data-out="w"]')!.textContent = `${Math.round(w * 100)}%`;
			el('readout').textContent = (root.dataset.readout || '')
				.replace('{p}', f(p))
				.replace('{a}', f(a))
				.replace('{g}', f(a - p))
				.replace('{mw}', f(mw * 100, 1))
				.replace('{ms}', f(ms));
		}

		rhoIn.addEventListener('input', draw);
		wIn.addEventListener('input', draw);
		draw();
	});
</script>
