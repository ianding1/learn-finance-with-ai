---
// Figure 4-1: each scenario's deviations and its probability-weighted contribution to the covariance.
// Two layouts: a wide one with the text left of the bars, and a narrow one for phones with the
// text above each bar. The figure shows the one that fits (container query in custom.css).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	zh: {
		names: ['繁荣', '正常', '衰退'],
		devA: 'A 偏差',
		devB: 'B 偏差',
		prod: '乘积',
		contrib: ['对协方差的贡献 = 概率 × 乘积（柱的粗细表示概率）'],
		contribNarrow: ['对协方差的贡献 = 概率 × 乘积', '柱的粗细表示概率'],
		sum: '加权求和',
		sep: '，',
	},
	en: {
		names: ['Boom', 'Normal', 'Recession'],
		devA: 'A dev.',
		devB: 'B dev.',
		prod: 'product',
		contrib: ['Contribution to covariance = probability × product (bar thickness shows probability)'],
		contribNarrow: ['Contribution to covariance', '= probability × product', '(bar thickness shows probability)'],
		sum: 'Weighted sum',
		sep: ', ',
	},
}[lang];

const p = [0.25, 0.5, 0.25];
const A = [30, 10, -10];
const B = [1, 5, 3];
const mean = (x: number[]) => x.reduce((s, v, i) => s + v * p[i], 0);
const mA = mean(A);
const mB = mean(B);
const rows = p.map((pi, i) => {
	const dA = A[i] - mA;
	const dB = B[i] - mB;
	return { name: L.names[i], p: pi, dA, dB, prod: dA * dB, c: pi * dA * dB };
});
const total = rows.reduce((s, r) => s + r.c, 0);
const signed = (v: number) => (v < 0 ? ` − ${Math.abs(v)}` : ` + ${v}`);
const fmt = (v: number) => (v > 0 ? `+${v}` : v < 0 ? `−${Math.abs(v)}` : '0');

const sumText = fmt(rows[0].c) + rows.slice(1).map((r) => signed(r.c)).join('');
const devText = (r: (typeof rows)[number]) =>
	[`${L.devA} ${fmt(r.dA)}`, `${L.devB} ${fmt(r.dB)}`, `${L.prod} ${fmt(r.prod)}`].join(L.sep);
const barH = (pi: number) => 8 + 40 * pi;

// Each row: the y of the name, of the deviations line, and of the bar's center.
// scale is px per unit of contribution.
const wideTop = 50;
const narrowTop = 18 * L.contribNarrow.length + 22;
const layouts = [
	{
		cls: 'viz-wide', W: 640, zeroX: 480, scale: 9, title: L.contrib,
		rows: rows.map((_, i) => { const y = wideTop + i * 56 + 20; return { name: y - 4, dev: y + 15, bar: y }; }),
		axis: [[wideTop - 10, wideTop + 56 * 3 - 6]],
		H: 270,
	},
	{
		cls: 'viz-narrow', W: 360, zeroX: 262, scale: 16, title: L.contribNarrow,
		rows: rows.map((_, i) => { const y = narrowTop + i * 84 + 16; return { name: y, dev: y + 19, bar: y + 48 }; }),
		// one zero line per bar, so that it does not cross the text of the next row
		axis: [0, 1, 2].map((i) => [narrowTop + i * 84 + 44, narrowTop + i * 84 + 84]),
		H: narrowTop + 84 * 2 + 16 + 48 + 62,
	},
];
---

{layouts.map((l) => (
	<svg class={`lfwai-viz ${l.cls}`} viewBox={`0 0 ${l.W} ${l.H}`} role="img" aria-label={L.contrib[0]}>
		{l.title.map((line, k) => <text class="viz-small" x="12" y={22 + 18 * k}>{line}</text>)}
		{l.axis.map(([y1, y2]) => <line class="viz-axis" x1={l.zeroX} x2={l.zeroX} y1={y1} y2={y2} />)}
		{rows.map((r, i) => {
			const y = l.rows[i];
			const h = barH(r.p);
			const w = Math.abs(r.c) * l.scale;
			const x = r.c < 0 ? l.zeroX - w : l.zeroX;
			return (
				<g>
					<text class="viz-label" x="12" y={y.name}>{`${r.name}  p = ${r.p}`}</text>
					<text class="viz-small" x="12" y={y.dev}>{devText(r)}</text>
					{w > 0 && <rect class={r.c < 0 ? 'viz-neg' : 'viz-pos'} x={x} y={y.bar - h / 2} width={w} height={h} rx="3" />}
					<text class="viz-value" x={r.c < 0 ? x - 6 : x + w + 6} y={y.bar + 5} text-anchor={r.c < 0 ? 'end' : 'start'}>{fmt(r.c)}</text>
				</g>
			);
		})}
		<text class="viz-label" x="12" y={l.H - 20}>{`${L.sum}: ${sumText} = ${fmt(total)} (%²)`}</text>
	</svg>
))}
