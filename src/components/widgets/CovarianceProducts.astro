---
// Figure 4-1: each scenario's deviations and its probability-weighted contribution to the covariance.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	zh: {
		names: ['繁荣', '正常', '衰退'],
		devA: 'A 偏差',
		devB: 'B 偏差',
		prod: '乘积',
		contrib: '对协方差的贡献 = 概率 × 乘积（柱的粗细表示概率）',
		sum: '加权求和',
	},
	en: {
		names: ['Boom', 'Normal', 'Recession'],
		devA: 'A dev.',
		devB: 'B dev.',
		prod: 'product',
		contrib: 'Contribution to covariance = probability × product (bar thickness shows probability)',
		sum: 'Weighted sum',
	},
}[lang];

const p = [0.25, 0.5, 0.25];
const A = [30, 10, -10];
const B = [1, 5, 3];
const mean = (x: number[]) => x.reduce((s, v, i) => s + v * p[i], 0);
const mA = mean(A);
const mB = mean(B);
const rows = p.map((pi, i) => {
	const dA = A[i] - mA;
	const dB = B[i] - mB;
	return { name: L.names[i], p: pi, dA, dB, prod: dA * dB, c: pi * dA * dB };
});
const total = rows.reduce((s, r) => s + r.c, 0);
const fmt = (v: number) => (v > 0 ? `+${v}` : v < 0 ? `−${Math.abs(v)}` : '0');

const zeroX = 480;
const scale = 9; // px per unit of contribution
const top = 50;
const rowH = 56;
---

<svg class="lfwai-viz" viewBox="0 0 640 270" role="img" aria-label={L.contrib}>
	<text class="viz-small" x="12" y="22">{L.contrib}</text>
	<line class="viz-axis" x1={zeroX} x2={zeroX} y1={top - 10} y2={top + rowH * 3 - 6} />
	{rows.map((r, i) => {
		const y = top + i * rowH + rowH / 2 - 8;
		const h = 8 + 40 * r.p;
		const w = Math.abs(r.c) * scale;
		const x = r.c < 0 ? zeroX - w : zeroX;
		return (
			<g>
				<text class="viz-label" x="12" y={y - 4}>{`${r.name}  p = ${r.p}`}</text>
				<text class="viz-small" x="12" y={y + 15}>{`${L.devA} ${fmt(r.dA)}   ${L.devB} ${fmt(r.dB)}   ${L.prod} ${fmt(r.prod)}`}</text>
				{w > 0 && <rect class={r.c < 0 ? 'viz-neg' : 'viz-pos'} x={x} y={y - h / 2} width={w} height={h} rx="3" />}
				<text class="viz-value" x={r.c < 0 ? x - 6 : x + w + 6} y={y + 5} text-anchor={r.c < 0 ? 'end' : 'start'}>{fmt(r.c)}</text>
			</g>
		);
	})}
	<text class="viz-label" x="12" y="250">{`${L.sum}: ${rows.map((r) => fmt(r.c)).join(' ')} = ${fmt(total)} (%²)`}</text>
</svg>
