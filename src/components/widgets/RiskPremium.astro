---
// Figure 4-1 of lesson 1.4: a 50/50 gamble between 100 − h and 100 + h (thousand dollars) under CRRA utility
// with relative risk aversion γ. Utility is rescaled so that u(100 − h) = 0 and u(100 + h) = 1; the chord's
// midpoint is the expected utility, and the certainty equivalent is where the curve reaches it.
// Parameters and ranges are registered in course/widgets.yaml (id: risk-premium). Keep them in sync.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		g: '相对风险厌恶系数 γ',
		h: '赌局的幅度 h',
		x: '财富 W（千美元）',
		y: '效用（标准化）',
		curve: '效用函数',
		chord: '两个结果之间的连线',
		ev: '期望财富',
		ce: '确定性等价',
		rp: '风险溢价',
		readout: '期望财富 100，确定性等价 {ce}，风险溢价 {rp}。',
	},
	en: {
		g: 'Relative risk aversion γ',
		h: 'Size of the gamble h',
		x: 'Wealth W (thousand dollars)',
		y: 'Utility (rescaled)',
		curve: 'Utility function',
		chord: 'Line between the two outcomes',
		ev: 'Expected wealth',
		ce: 'Certainty equivalent',
		rp: 'Risk premium',
		readout: 'Expected wealth 100, certainty equivalent {ce}, risk premium {rp}.',
	},
}[lang];

const xr = [0, 200];
const yr = [-0.6, 1.4];
const xTicks = [0, 50, 100, 150, 200];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 340, pad: { l: 40, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 32, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="risk-premium" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.g} = <output data-out="g">1</output></span>
			<input type="range" min="0" max="5" step="0.5" value="1" data-param="g" />
		</label>
		<label>
			<span>{L.h} = <output data-out="h">50</output></span>
			<input type="range" min="10" max="90" step="10" value="50" data-param="h" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.curve} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`rp-clip-${cls}`}>
					<rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} />
				</clipPath>
			</defs>
			<line class="viz-grid" x1={pad.l} x2={W - pad.r} y1={Y(0)} y2={Y(0)} />
			<line class="viz-grid" x1={pad.l} x2={W - pad.r} y1={Y(1)} y2={Y(1)} />
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={W - pad.r} y1={H - pad.b} y2={H - pad.b} />
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(14 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<g clip-path={`url(#rp-clip-${cls})`}>
				<path class="viz-curve" data-el="curve" d="" />
				<line class="viz-ols" data-el="chord" x1="0" y1="0" x2="0" y2="0" />
				<line class="viz-gap" data-el="gap" x1="0" y1="0" x2="0" y2="0" />
				<line class="viz-mean" data-el="vce" x1="0" y1="0" x2="0" y2="0" />
				<line class="viz-mean" data-el="vev" x1="0" y1="0" x2="0" y2="0" />
			</g>
			<circle class="viz-hollow" data-el="lo" r="5" cx="0" cy="0" />
			<circle class="viz-hollow" data-el="hi" r="5" cx="0" cy="0" />
			<circle class="viz-cur" data-el="ev" r="6" cx="0" cy="0" />
			<circle class="viz-min" data-el="ce" r="6" cx="0" cy="0" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.curve}</li>
		<li><span class="sw sw-ols"></span>{L.chord}</li>
		<li><span class="sw sw-min"></span>{L.ce}</li>
		<li><span class="sw sw-gap"></span>{L.rp}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initRiskPremium } from '../../scripts/widgets/risk-premium';
	initRiskPremium();
</script>
