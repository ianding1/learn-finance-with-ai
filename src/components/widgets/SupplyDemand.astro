---
// Figure 4-1 of lesson 1.1: demand Q = 100 + ΔD − 2P and supply Q = −20 + ΔS + 4P. The sliders shift
// the curves horizontally; dashed lines are the original curves (ΔD = ΔS = 0).
// Parameters and ranges are registered in course/widgets.yaml (id: supply-demand). Keep them in sync.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		dD: '需求移动 ΔD',
		dS: '供给移动 ΔS',
		x: '数量 Q',
		y: '价格 P',
		demand: '需求曲线',
		supply: '供给曲线',
		orig: '原来的曲线',
		eq: '新的均衡',
		eq0: '原来的均衡',
		readout: '均衡价格 P = {p}，均衡数量 Q = {q}（原来是 P = 20，Q = 60）。',
	},
	en: {
		dD: 'Demand shift ΔD',
		dS: 'Supply shift ΔS',
		x: 'Quantity Q',
		y: 'Price P',
		demand: 'Demand curve',
		supply: 'Supply curve',
		orig: 'Original curves',
		eq: 'New equilibrium',
		eq0: 'Original equilibrium',
		readout: 'Equilibrium price P = {p}, equilibrium quantity Q = {q} (originally P = 20, Q = 60).',
	},
}[lang];

const qr = [0, 140];
const pr = [0, 70];
const qTicks = [0, 20, 40, 60, 80, 100, 120, 140];
const qTicksNarrow = [0, 40, 80, 120];
const pTicks = [0, 10, 20, 30, 40, 50, 60, 70];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 340, pad: { l: 56, r: 20, t: 14, b: 48 }, qt: qTicks },
	{ cls: 'viz-narrow', W: 360, H: 320, pad: { l: 48, r: 12, t: 14, b: 48 }, qt: qTicksNarrow },
].map((g) => ({
	...g,
	X: (q: number) => g.pad.l + ((q - qr[0]) / (qr[1] - qr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (p: number) => g.pad.t + ((pr[1] - p) / (pr[1] - pr[0])) * (g.H - g.pad.t - g.pad.b),
}));
// Original curves, drawn once: demand from P = 50 at Q = 0 to Q = 100 at P = 0; supply from (0, 5) to (140, 40).
---

<div class="lfwai-widget" data-widget="supply-demand" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.dD} = <output data-out="dD">0</output></span>
			<input type="range" min="-30" max="30" step="5" value="0" data-param="dD" />
		</label>
		<label>
			<span>{L.dS} = <output data-out="dS">0</output></span>
			<input type="range" min="-30" max="30" step="5" value="0" data-param="dS" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y, qt }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${L.demand}, ${L.supply}`} data-geom={JSON.stringify({ W, H, pad, qr, pr })}>
			{pTicks.map((p) => (
				<g>
					<line class={p === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(p)} y2={Y(p)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(p) + 4} text-anchor="end">{p}</text>
				</g>
			))}
			{qt.map((q) => (
				<text class="viz-tick" x={X(q)} y={H - pad.b + 18} text-anchor="middle">{q}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(14 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<line class="viz-ols" x1={X(0)} y1={Y(50)} x2={X(100)} y2={Y(0)} />
			<line class="viz-ols" x1={X(0)} y1={Y(5)} x2={X(140)} y2={Y(40)} />
			<line class="viz-mean" data-el="hq" x1="0" y1="0" x2="0" y2="0" />
			<line class="viz-mean" data-el="vq" x1="0" y1="0" x2="0" y2="0" />
			<line class="viz-curve" data-el="demand" x1="0" y1="0" x2="0" y2="0" />
			<line class="viz-curve-fat" data-el="supply" x1="0" y1="0" x2="0" y2="0" />
			<circle class="viz-hollow" cx={X(60)} cy={Y(20)} r="6" />
			<circle class="viz-min" data-el="eq" r="6" cx="0" cy="0" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.demand}</li>
		<li><span class="sw sw-fat"></span>{L.supply}</li>
		<li><span class="sw sw-ols"></span>{L.orig}</li>
		<li><span class="sw sw-min"></span>{L.eq}</li>
		<li><span class="sw sw-hollow"></span>{L.eq0}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initSupplyDemand } from '../../scripts/widgets/supply-demand';
	initSupplyDemand();
</script>
