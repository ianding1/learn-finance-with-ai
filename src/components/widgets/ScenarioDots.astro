---
// Figure 3-1: outcomes of A and B on one axis; dot area is proportional to probability.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	zh: { a: '股票 A', b: '债券 B', e: '期望', axis: '年收益（%）' },
	en: { a: 'Stock A', b: 'Bond fund B', e: 'Expected', axis: 'Annual return (%)' },
}[lang];

const p = [0.25, 0.5, 0.25];
const rows = [
	{ name: L.a, cls: 'a', y: 70, values: [30, 10, -10] },
	{ name: L.b, cls: 'b', y: 150, values: [1, 5, 3] },
];
const W = 640;
const x0 = 110;
const x1 = 610;
const lo = -15;
const hi = 35;
const X = (v: number) => x0 + ((v - lo) / (hi - lo)) * (x1 - x0);
const ticks = [-10, 0, 10, 20, 30];
const radius = (pi: number) => 6 + 14 * Math.sqrt(pi);
const mean = (vs: number[]) => vs.reduce((s, v, i) => s + v * p[i], 0);
---

<svg class="lfwai-viz" viewBox={`0 0 ${W} 230`} role="img" aria-label={`${L.a} / ${L.b}`}>
	{ticks.map((tk) => (
		<g>
			<line class="viz-grid" x1={X(tk)} x2={X(tk)} y1="30" y2="185" />
			<text class="viz-tick" x={X(tk)} y="203" text-anchor="middle">{tk}</text>
		</g>
	))}
	<text class="viz-tick" x={(x0 + x1) / 2} y="224" text-anchor="middle">{L.axis}</text>
	{rows.map((r) => {
		const m = mean(r.values);
		return (
			<g>
				<text class="viz-label" x="12" y={r.y + 5}>{r.name}</text>
				<line class="viz-axis" x1={x0} x2={x1} y1={r.y} y2={r.y} />
				{r.values.map((v, i) => (
					<circle class={`viz-dot viz-${r.cls}`} cx={X(v)} cy={r.y} r={radius(p[i])}>
						<title>{`${r.name}: ${v}%, p = ${p[i]}`}</title>
					</circle>
				))}
				<line class="viz-mean" x1={X(m)} x2={X(m)} y1={r.y - 30} y2={r.y + 30} />
				<text class="viz-small" x={X(m)} y={r.y - 34} text-anchor="middle">{`${L.e} ${m}%`}</text>
			</g>
		);
	})}
</svg>
