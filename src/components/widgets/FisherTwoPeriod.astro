---
// Figure 3-1 of lesson 1.3: two-period consumption with U = ln c1 + β ln c2, β = 0.95, income y1 = 80 today
// and y2 tomorrow. The budget line passes through the endowment (y1, y2) with slope −(1 + r).
// Parameters and ranges are registered in course/widgets.yaml (id: fisher). Keep them in sync.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		r: '利率 r（%）',
		y2: '明天的收入 y₂',
		x: '今天的消费 c₁',
		y: '明天的消费 c₂',
		budget: '跨期预算线',
		ic: '经过最优点的无差异曲线',
		endow: '收入点 (y₁, y₂)',
		opt: '最优消费',
		readout: '最优消费 c₁ = {c1}，c₂ = {c2}。今天{verb} {s}。',
		save: '储蓄',
		borrow: '借款',
	},
	en: {
		r: 'Interest rate r (%)',
		y2: "Tomorrow's income y₂",
		x: 'Consumption today c₁',
		y: 'Consumption tomorrow c₂',
		budget: 'Intertemporal budget line',
		ic: 'Indifference curve through the optimum',
		endow: 'Income point (y₁, y₂)',
		opt: 'Best consumption',
		readout: 'Best consumption c₁ = {c1}, c₂ = {c2}. Today the consumer {verb} {s}.',
		save: 'saves',
		borrow: 'borrows',
	},
}[lang];

const xr = [0, 140];
const yr = [0, 170];
const xTicks = [0, 20, 40, 60, 80, 100, 120, 140];
const xTicksNarrow = [0, 40, 80, 120];
const yTicks = [0, 40, 80, 120, 160];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 360, pad: { l: 52, r: 20, t: 14, b: 44 }, xt: xTicks },
	{ cls: 'viz-narrow', W: 360, H: 320, pad: { l: 46, r: 12, t: 14, b: 44 }, xt: xTicksNarrow },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="fisher" data-readout={L.readout} data-verbs={JSON.stringify([L.save, L.borrow])}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.r} = <output data-out="r">10</output></span>
			<input type="range" min="0" max="30" step="1" value="10" data-param="r" />
		</label>
		<label>
			<span>{L.y2} = <output data-out="y2">22</output></span>
			<input type="range" min="0" max="60" step="2" value="22" data-param="y2" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y, xt }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.budget} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`fisher-clip-${cls}`}>
					<rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} />
				</clipPath>
			</defs>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xt.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(14 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<g clip-path={`url(#fisher-clip-${cls})`}>
				<path class="viz-level" data-el="ic" d="" />
				<line class="viz-budget" data-el="budget" x1="0" y1="0" x2="0" y2="0" />
			</g>
			<line class="viz-mean" data-el="h" x1="0" y1="0" x2="0" y2="0" />
			<line class="viz-mean" data-el="v" x1="0" y1="0" x2="0" y2="0" />
			<circle class="viz-hollow" data-el="E" r="6" cx="0" cy="0" />
			<circle class="viz-min" data-el="opt" r="6" cx="0" cy="0" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-budget"></span>{L.budget}</li>
		<li><span class="sw sw-level"></span>{L.ic}</li>
		<li><span class="sw sw-hollow"></span>{L.endow}</li>
		<li><span class="sw sw-min"></span>{L.opt}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initFisher } from '../../scripts/widgets/fisher';
	initFisher();
</script>
