---
// Figure 2-1 of lesson 0.4: a normal density and a fat-tailed density (a t distribution with 3 degrees of
// freedom, scaled to the same standard deviation 1). Left: the whole curves. Right: the tail from 2.5 to 5
// standard deviations, enlarged. Static. On phones the two panels are stacked.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': { normal: '正态分布', fat: '肥尾分布（标准差相同）', axis: '离期望几个标准差', zoom: '右尾放大' },
	en: { normal: 'Normal distribution', fat: 'Fat-tailed distribution (same standard deviation)', axis: 'Standard deviations from the mean', zoom: 'Right tail, enlarged' },
}[lang];

const normal = (z: number) => Math.exp(-0.5 * z * z) / Math.sqrt(2 * Math.PI);
// t with 3 degrees of freedom has variance 3; scale it by sqrt(3) so that its standard deviation is 1.
const s = Math.sqrt(3);
const t3 = (x: number) => (2 / (Math.PI * Math.sqrt(3) * (1 + (x * x) / 3) ** 2));
const fat = (z: number) => s * t3(z * s);

type Panel = { x: number; y: number; w: number; h: number; lo: number; hi: number; top: number; ticks: number[] };
const curve = (p: Panel, f: (z: number) => number) => {
	const n = 160;
	let d = '';
	for (let i = 0; i <= n; i++) {
		const z = p.lo + ((p.hi - p.lo) * i) / n;
		const X = p.x + ((z - p.lo) / (p.hi - p.lo)) * p.w;
		const Y = p.y + p.h - (Math.min(f(z), p.top) / p.top) * p.h;
		d += `${i ? 'L' : 'M'}${X.toFixed(1)},${Y.toFixed(1)}`;
	}
	return d;
};
const tx = (p: Panel, z: number) => p.x + ((z - p.lo) / (p.hi - p.lo)) * p.w;

const full = (x: number, y: number, w: number, h: number): Panel => ({ x, y, w, h, lo: -5, hi: 5, top: 0.7, ticks: [-4, -2, 0, 2, 4] });
const tail = (x: number, y: number, w: number, h: number): Panel => ({ x, y, w, h, lo: 2.5, hi: 5, top: 0.03, ticks: [3, 4, 5] });
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 270, panels: [full(16, 30, 330, 180), tail(380, 30, 244, 180)] },
	{ cls: 'viz-narrow', W: 360, H: 480, panels: [full(14, 30, 332, 160), tail(14, 262, 332, 140)] },
];
---

{layouts.map(({ cls, W, H, panels }) => (
	<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${L.normal} / ${L.fat}`}>
		{panels.map((p, i) => (
			<g>
				{i === 1 && <text class="viz-label" x={p.x} y={p.y - 10}>{L.zoom}</text>}
				<line class="viz-axis" x1={p.x} x2={p.x + p.w} y1={p.y + p.h} y2={p.y + p.h} />
				{p.ticks.map((z) => (
					<text class="viz-tick" x={tx(p, z)} y={p.y + p.h + 18} text-anchor="middle">{z}</text>
				))}
				<path class="viz-curve" d={curve(p, normal)} />
				<path class="viz-curve-fat" d={curve(p, fat)} />
				<text class="viz-tick" x={p.x + p.w / 2} y={p.y + p.h + 38} text-anchor="middle">{L.axis}</text>
			</g>
		))}
	</svg>
))}
<ul class="lfwai-legend">
	<li><span class="sw sw-curve"></span>{L.normal}</li>
	<li><span class="sw sw-fat"></span>{L.fat}</li>
</ul>
