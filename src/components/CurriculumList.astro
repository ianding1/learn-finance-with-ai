---
// The full course outline from course/curriculum.yaml, with links to published lessons. Each
// published lesson or quiz with questions shows the learner's status (not started / in progress /
// done; a finished quiz also shows its total score),
// filled in from the stored progress by src/scripts/lesson-status.ts.
import { toLang, t } from '../i18n/ui';
import { stages, lessonPath, lessonKey } from '../lib/course';

const qids = (id: string) => (lessonKey(id)?.questions ?? []).map((q) => q.id);

const lang = toLang(Astro.locals.starlightRoute.lang);
---

<div class="lfwai-curriculum not-content">
	{stages().map((s) => (
		<section>
			<h3>{s.title[lang]}</h3>
			<ol>
				{s.lessons.map((l) => (
					<li class={l.exam ? 'is-exam' : ''}>
						<span class="lfwai-cid">{l.id}</span>
						{l.published ? (
							<>
								<a href={lessonPath(l, lang)}>{l.title[lang]}</a>
								{qids(l.id).length > 0 && (
									<span class="lfwai-lstatus" data-lesson-status={l.id} data-questions={qids(l.id).join(',')} hidden></span>
								)}
							</>
						) : (
							<span class="lfwai-muted">
								{l.title[lang]}
								<span class="ref-status">{lang === 'en' ? ` (${t(lang, 'unpublished')})` : `（${t(lang, 'unpublished')}）`}</span>
							</span>
						)}
					</li>
				))}
			</ol>
		</section>
	))}
</div>

<script>
	import { initLessonStatus } from '../scripts/lesson-status';
	initLessonStatus();
</script>
