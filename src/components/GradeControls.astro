---
// Submission controls for a group of questions: copy the grading prompt and paste the result back.
// Each question shows its own result (QuestionBody).
import { t, type Lang } from '../i18n/ui';
import { toJson } from '../lib/grading';

interface Props {
	lang: Lang;
	payload: unknown;
	/** true for a quiz: the prompt asks for scores */
	scored?: boolean;
}
const { lang, payload, scored = false } = Astro.props;
---

<div class="lfwai-controls">
	<button type="button" class="lfwai-btn lfwai-btn-primary" data-grade>{t(lang, scored ? 'copyGrading' : 'copyFeedback')}</button>
	<p class="lfwai-hint">{t(lang, 'copyHint')}</p>
	<details class="lfwai-result">
		<summary>{t(lang, 'pasteResult')}</summary>
		<p class="lfwai-hint">{t(lang, 'pasteHint')}</p>
		<textarea rows="4" data-result aria-label={t(lang, 'pasteResult')}></textarea>
		<button type="button" class="lfwai-btn" data-save>{t(lang, 'saveResult')}</button>
		<p class="lfwai-status" data-status role="status"></p>
	</details>
	<script type="application/json" data-payload set:html={toJson(payload)}></script>
</div>

<script>
	import { initGradeGroups } from '../scripts/questions';
	initGradeGroups();
</script>
