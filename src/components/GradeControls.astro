---
// Submission controls for a group of questions: copy the grading prompt, see which questions are
// already graded, and paste the result back.
import { t, type Lang } from '../i18n/ui';
import { toJson } from '../lib/grading';

interface Props {
	lang: Lang;
	payload: unknown;
	/** false for exercises, which the AI reviews without scores */
	scored?: boolean;
}
const { lang, payload, scored = true } = Astro.props;
---

<div class="lfwai-controls">
	<button type="button" class="lfwai-btn lfwai-btn-primary" data-grade>{t(lang, scored ? 'copyGrading' : 'copyReview')}</button>
	<p class="lfwai-hint">{scored ? '' : t(lang, 'exercisesHint')}{t(lang, 'copyHint')}</p>
	<p class="lfwai-progress" data-progress></p>
	<details class="lfwai-result">
		<summary>{t(lang, 'pasteResult')}</summary>
		<p class="lfwai-hint">{t(lang, 'pasteHint')}</p>
		<textarea rows="4" data-result aria-label={t(lang, 'pasteResult')}></textarea>
		<button type="button" class="lfwai-btn" data-save>{t(lang, 'saveResult')}</button>
		<p class="lfwai-status" data-status role="status"></p>
	</details>
	<script type="application/json" data-payload set:html={toJson(payload)}></script>
</div>

<script>
	import { initGradeGroups } from '../scripts/questions';
	initGradeGroups();
</script>
