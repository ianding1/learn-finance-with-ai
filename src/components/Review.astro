---
// <Review /> — start of a lesson: the prerequisites (from `uses` in course/curriculum.yaml) and a
// button that copies a personalized review prompt. The prompt uses the concepts the learner needs to
// practice (from the learner profile) that were taught before this lesson; without any, it uses the
// prerequisites. The AI writes the review questions on the spot; nothing is scored.
import { toLang, t } from '../i18n/ui';
import { lesson, lessons, concepts, refHtml } from '../lib/course';
import { toJson } from '../lib/grading';

const route = Astro.locals.starlightRoute;
const lang = toLang(route.lang);
const lessonId = route.entry.data.lesson;
if (!lessonId) throw new Error('<Review> can only be used on a lesson page (frontmatter "lesson")');
const l = lesson(lessonId);
const all = concepts();
const order = new Map(lessons().map((x) => [x.id, x]));
const where = (defined: string) => {
	if (defined === 'prerequisite') return '';
	const d = order.get(defined)!;
	return t(lang, 'lessonPlain', { id: d.id, title: d.title[lang] });
};
// Concepts taught before this lesson: the only ones a review may cover.
const reviewable = Object.fromEntries(
	Object.values(all)
		.filter((c) => c.defined_in === 'prerequisite' || order.get(c.defined_in)!.order < l.order)
		.map((c) => [c.id, { name: c[lang], short: c.short?.[lang], where: where(c.defined_in) }]),
);
const prereqs = l.uses ?? [];
const prereqHtml = prereqs.map((id) => refHtml({ concept: id }, lang, lessonId)).join(lang === 'zh' ? '、' : ', ');
---

<section class="lfwai-group lfwai-review not-content" data-review>
	{prereqs.length > 0 && <p class="lfwai-prereq"><strong>{t(lang, 'prereqLabel')}</strong><span set:html={prereqHtml} /></p>}
	<button type="button" class="lfwai-btn lfwai-btn-primary" data-review-copy>{t(lang, 'copyReviewQuiz')}</button>
	<p class="lfwai-hint">{t(lang, 'reviewHint')}</p>
	<p class="lfwai-progress" data-review-focus hidden></p>
	<script type="application/json" data-review-data set:html={toJson({ reviewable, prereqs })}></script>
</section>

<script>
	import { initReview } from '../scripts/review';
	initReview();
</script>
