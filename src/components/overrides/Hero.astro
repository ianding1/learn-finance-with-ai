---
// Home page hero: title, tagline and the start button from the page's `hero` frontmatter, next to
// a decorative efficient frontier. Once the learner has progress, the button
// leads to the first lesson that is not done (src/scripts/home.ts).
import { toLang, t } from '../../i18n/ui';
import { lessons, lessonKey, lessonPath } from '../../lib/course';

const route = Astro.locals.starlightRoute;
const lang = toLang(route.lang);
const hero = route.entry.data.hero!;
const action = hero.actions?.[0];

// Decorative efficient frontier (no text): a cloud of possible portfolios, the frontier along their
// upper-left edge, and the capital market line from the risk-free rate, tangent to the frontier.
const W = 560, H = 360, pad = 20;
const X = (sd: number) => pad + (sd / 0.3) * (W - 2 * pad);
const Y = (mu: number) => H - pad - (mu / 0.16) * (H - 2 * pad);
const sdMin = 0.08, muMin = 0.06, k = 0.75, rf = 0.025;
const sdOf = (mu: number) => Math.sqrt(sdMin ** 2 + ((mu - muMin) / k) ** 2);
const curve = (from: number, to: number) =>
	'M' + Array.from({ length: 61 }, (_, i) => from + ((to - from) * i) / 60).map((mu) => `${X(sdOf(mu)).toFixed(1)},${Y(mu).toFixed(1)}`).join('L');
const upper = curve(muMin, 0.15);
const lower = curve(0.02, muMin);
// Tangency portfolio: the frontier point with the highest (mu - rf) / sd.
let tMu = muMin;
for (let mu = muMin; mu <= 0.15; mu += 0.0005) if ((mu - rf) / sdOf(mu) > (tMu - rf) / sdOf(tMu)) tMu = mu;
const slope = (tMu - rf) / sdOf(tMu);
const cmlEnd = 0.28;
const cml = `M${X(0).toFixed(1)},${Y(rf).toFixed(1)}L${X(cmlEnd).toFixed(1)},${Y(rf + slope * cmlEnd).toFixed(1)}`;
// Random portfolios inside the frontier (fixed seed, so every build draws the same picture).
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const dots = Array.from({ length: 170 }, () => {
	const mu = 0.022 + rand() * 0.12;
	const sd = sdOf(mu) * (1.03 + rand() ** 1.6 * 1.1);
	return { x: X(Math.min(sd, 0.29)), y: Y(mu), o: (0.25 + rand() * 0.45).toFixed(2) };
});

const data = {
	label: t(lang, 'continueAt', { title: '{title}' }),
	lessons: lessons()
		.filter((l) => l.published && (lessonKey(l.id)?.questions.length ?? 0) > 0)
		.map((l) => ({ id: l.id, title: `${l.id} ${l.title[lang]}`, href: lessonPath(l, lang), questions: lessonKey(l.id)!.questions.map((q) => q.id) })),
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<div class="lfwai-hero">
	<div class="lfwai-hero-text">
		<h1 id="_top" data-page-title>{hero.title}</h1>
		{hero.tagline && <p class="lfwai-hero-tagline" set:html={hero.tagline} />}
		{action && (
			<a class="lfwai-hero-start" href={action.link} data-start>{action.text}</a>
		)}
	</div>
	<div class="lfwai-hero-chart" aria-hidden="true">
		<svg viewBox={`0 0 ${W} ${H}`}>
			<path class="lfwai-hero-axis" d={`M${pad},${pad}V${H - pad}H${W - pad}`} />
			{dots.map((d) => <circle class="lfwai-hero-dot" cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="3" style={`opacity:${d.o}`} />)}
			<path class="lfwai-hero-lower" d={lower} />
			<path class="lfwai-hero-line" d={upper} pathLength="1" />
			<path class="lfwai-hero-cml" d={cml} pathLength="1" />
			<circle class="lfwai-hero-rf" cx={X(0)} cy={Y(rf)} r="5" />
			<circle class="lfwai-hero-tangent" cx={X(sdOf(tMu))} cy={Y(tMu)} r="7" />
		</svg>
	</div>
</div>
<script type="application/json" id="lfwai-home-data" set:html={json}></script>

<script>
	import { initHome } from '../../scripts/home';
	initHome();
</script>
