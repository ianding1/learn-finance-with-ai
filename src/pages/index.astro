---
// The site root has no language of its own. It sends visitors to the language of their browser,
// or to the default language in src/i18n/languages.json, and lists every language as plain links.
import config from '../i18n/languages.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const langs = config.languages.map((l) => ({ ...l, href: `${base}/${l.code}/` }));
const fallback = langs.find((l) => l.code === config.default)!;
const data = JSON.stringify(langs.map((l) => ({ tag: l.lang.toLowerCase(), href: l.href }))).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{langs.map((l) => l.title).join(' · ')}</title>
		<noscript><meta http-equiv="refresh" content={`0; url=${fallback.href}`} /></noscript>
		<script is:inline define:vars={{ data, fallbackHref: fallback.href }}>
			const langs = JSON.parse(data);
			const prefs = (navigator.languages || [navigator.language || '']).map((s) => s.toLowerCase());
			const pick = (p) => langs.find((l) => l.tag === p) || langs.find((l) => l.tag.split('-')[0] === p.split('-')[0]);
			const hit = prefs.map(pick).find(Boolean);
			location.replace((hit ? hit.href : fallbackHref) + location.hash);
		</script>
		<style>
			body { font-family: system-ui, sans-serif; background: #fff; color: #222; margin: 3rem 1rem; text-align: center; }
			a { display: inline-block; margin: 0.5rem 1rem; font-size: 1.1rem; }
		</style>
	</head>
	<body>
		{langs.map((l) => <a href={l.href} lang={l.lang}>{l.label}</a>)}
	</body>
</html>
